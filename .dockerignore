# Build context hygiene — keep `docker build` (context: .) lean and secret-free.
# The maia/Dockerfile copies only atlas/ and maia/ explicitly.

# Virtual envs / caches
.venv/
**/__pycache__/
**/*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.aws/
.gcp/

# VCS + CI
.git/
.github/

# Large media / dumps that must never be baked into an image
*.webm
*.mp4
*.pdf
*.log

# Local secrets / cookies — mount these at runtime, never COPY them in
*.cookies.txt
new_cookies.txt
final_cookies.txt
www.youtube.cookies.txt
yt_cookies.txt

# Unrelated workloads (separate build contexts)
alkyone/
training/
hf-spaces/
tools/
data/
docs/
agents/
skills-lock.json
SUMMARY.md
refactor_draft.md
refactor_draft.pdf

# Misc
**/node_modules/
.DS_Store
